# Database Configuration
DATABASE_URL=postgresql://user:password@db:5432/nasadb

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token

# AI Configuration
# If GEMINI_API_KEY is provided, it will use Gemini (gemini-1.5-flash).
# If OPENAI_API_KEY is provided, it will use OpenAI (gpt-4o-mini).
# Otherwise, it will fallback to local Ollama.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama Configuration
# Default assumes Ollama is running on your host machine (Mac/Windows Docker setup).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
